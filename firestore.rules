rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "gr23456789jam@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.slug is string && data.slug.size() <= 100 &&
             data.nombre is string && data.nombre.size() <= 150 &&
             data.linea in ['Running', 'Training', 'Altura'] &&
             data.composicion is string && data.composicion.size() <= 200 &&
             data.publico in ['Hombre', 'Mujer', 'Unisex'] &&
             data.precio is number && data.precio >= 0 &&
             data.stock is number && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 50 &&
             data.subtotal is number && data.subtotal >= 0 &&
             data.total is number && data.total >= 0 &&
             data.estado in ['Pendiente', 'Confirmado', 'En camino', 'Entregado'];
    }

    function isValidLead(data) {
      return data.id is string && data.id.size() <= 50 &&
             data.email is string && data.email.size() <= 150 && data.email.matches('.+@.+\\..+');
    }

    function isValidComplaint(data) {
      return data.ticket is string && data.ticket.size() <= 50 &&
             data.nombre is string && data.nombre.size() <= 150 &&
             data.email is string && data.email.size() <= 150 &&
             data.descripcion is string && data.descripcion.size() <= 2000;
    }

    function isValidUser(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['user', 'admin'];
    }

    // Collection: Products (Public Catalog, Admin Controlled)
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Collection: Orders
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.customer.email == request.auth.token.email);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customer.email == request.auth.token.email);
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming()) &&
                    incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Collection: Leads (Run Club & Guía)
    match /leads/{leadId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow update, delete: if isAdmin() && isValidId(leadId);
    }

    // Collection: Complaints (Libro de Reclamaciones)
    match /complaints/{complaintId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(complaintId) && isValidComplaint(incoming());
      allow update, delete: if isAdmin() && isValidId(complaintId);
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
                    (incoming().role == 'user' || isAdmin());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
                    (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collection: Admins Registry
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Health / Connection Test
    match /test/{docId} {
      allow read: if true;
    }
  }
}
